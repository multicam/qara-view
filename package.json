{
  "name": "qara-view",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run server.ts & bunx vite dev",
    "dev:api": "bun run server.ts",
    "dev:ui": "bunx vite dev",
    "build": "bunx vite build",
    "start": "bun run server.ts",
