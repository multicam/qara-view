    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "linkify-it": ">=5.0.2 <6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tldraw": "^4.5.4"
  },
  "overrides": {
    "@tiptap/core": ">=3.30.5 <4",
