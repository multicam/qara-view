{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "includes": ["**", "!!node_modules", "!!dist", "!!thoughts", "!!.pi-run-provisioning.json"]
  },
  "formatter": {
    "enabled": true,
    "includes": ["*.json", "*.html"],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 200
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noStaticElementInteractions": "warn",
        "useButtonType": "warn",
        "useKeyWithClickEvents": "warn"
      },
      "suspicious": {
        "useIterableCallbackReturn": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tests/**"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
